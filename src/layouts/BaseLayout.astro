---
import '@/styles/globals.css';
import AppShell from '../components/AppShell.tsx';
import Footer from '../components/Footer.astro';
import type { Language } from '../i18n/translations';
import { getLangFromUrl, localizedPath } from '../i18n/routing';

export interface Props {
  title?: string;
  description?: string;
  // 显式传入语言,优先级高于 URL 自动推断(默认从 URL 推断)
  lang?: Language;
  canonical?: string;
  ogImage?: string;
  // SEO 关键词:传入则输出 <meta name="keywords">,中英双语页面按需传入对应语言
  keywords?: string[];
  // 文章类页面（教程/博客/法律页）专用 meta，普通工具页不传
  articleMeta?: {
    author?: string;
    section?: string;
    tags?: string[];
    publishedTime?: string; // ISO 8601
    modifiedTime?: string; // ISO 8601
  };
}

const {
  title = 'Momo工具箱 - 极速、专业的在线工具集合',
  description = '所有数据浏览器本地处理，即开即用，保护隐私。',
  lang: langProp,
  canonical,
  ogImage = '/og-image.svg',
  keywords,
  articleMeta,
} = Astro.props;

// 从 URL 推断语言(/en/* → en,其他 → zh),允许 prop 覆盖
const urlLang = getLangFromUrl(Astro.url.pathname);
const lang: Language = langProp || urlLang;

// canonical:如未传入则基于当前 URL 生成
const fullCanonical = canonical || new URL(Astro.url.pathname, Astro.site).toString();

// 计算 hreflang 配对的"原始路径"(剥离 /en 前缀)
let rawPath = Astro.url.pathname;
if (lang === 'en') {
  rawPath = rawPath.replace(/^\/en/, '');
  if (rawPath === '' || rawPath === '/en') rawPath = '/';
}
// 中文版 canonical URL
const zhCanonical = new URL(localizedPath(rawPath, 'zh'), Astro.site).toString();
// 英文版 canonical URL
const enCanonical = new URL(localizedPath(rawPath, 'en'), Astro.site).toString();

const fullOgImage = new URL(ogImage, Astro.site).toString();
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'} data-lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <link rel="canonical" href={fullCanonical} />

    {/* hreflang 双语对应声明:Google 用此判断中英版本配对,避免"备用网页"误判 */}
    <link rel="alternate" hreflang="zh-CN" href={zhCanonical} />
    <link rel="alternate" hreflang="en" href={enCanonical} />
    <link rel="alternate" hreflang="x-default" href={zhCanonical} />

    <!-- PWA -->
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#d97706" />

    {/* Google AdSense:声明发布商账号 */}
    <meta name="google-adsense-account" content="ca-pub-1315335444091074" />

    {/* Google Analytics 4 (GA4):衡量 ID G-JS7KRW5MET */}
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-JS7KRW5MET"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-JS7KRW5MET');
    </script>

    {/* Google AdSense:加载广告库(全站共享,只加载一次) */}
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1315335444091074"
      crossorigin="anonymous"
    ></script>

    {/* Open Graph：文章类页面用 article，其余用 website（og:type 只能出现一次） */}
    <meta property="og:type" content={articleMeta ? 'article' : 'website'} />
    <meta property="og:site_name" content="Momo Toolbox" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Momo Toolbox - Online Tools" />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'zh' ? 'en_US' : 'zh_CN'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />
    <meta name="twitter:image:alt" content="Momo Toolbox - Online Tools" />

    {/* 文章类页面专用 Open Graph article meta（仅当 articleMeta 传入时输出；og:type 已在上方条件渲染） */}
    {articleMeta && (
      <>
        <meta property="article:author" content={articleMeta.author || 'Momo Toolbox'} />
        <meta property="article:section" content={articleMeta.section || 'Tutorial'} />
        {articleMeta.publishedTime && <meta property="article:published_time" content={articleMeta.publishedTime} />}
        {articleMeta.modifiedTime && <meta property="article:modified_time" content={articleMeta.modifiedTime} />}
        {(articleMeta.tags || []).map(tag => <meta property="article:tag" content={tag} />)}
      </>
    )}

    <!-- 字体 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600;700&family=Lora:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    {/* 初始化语言(SSR 已根据 URL 决定 lang 属性,这里同步 data-lang 给 CSS) */}
    <script is:inline>
      (function () {
        try {
          // 优先级:localStorage 用户偏好 > 当前 URL 推断
          var saved = localStorage.getItem('momo-lang');
          // 仅当用户明确选过语言且与当前 URL 一致时使用,避免冲突
          var urlLang = document.documentElement.getAttribute('data-lang');
          if (saved === 'zh' || saved === 'en') {
            // 检查 URL 与偏好是否一致,不一致时以 URL 为准(SSR 已渲染对应语言)
            // 但保留 saved 作为切换时的参考
            if (saved !== urlLang) {
              // URL 是 /en/* 但用户偏好 zh(或反之):以 URL 为准,更新 localStorage
              localStorage.setItem('momo-lang', urlLang);
              saved = urlLang;
            }
          } else {
            saved = urlLang;
            localStorage.setItem('momo-lang', urlLang);
          }
          document.documentElement.lang = saved === 'en' ? 'en' : 'zh-CN';
        } catch (e) {}
      })();
    </script>

    {/* 根路径(仅 /)的浏览器语言自动跳转:首次访问且未设偏好的老外跳 /en/
        - 只在 / 根路径执行,避免每次访问都跳
        - 只在没有 momo-lang 偏好时执行(用户切换过语言就尊重)
        - 浏览器语言以 en 开头且不含 zh 时跳转
        - Googlebot 的 Accept-Language 不影响(爬虫不执行 JS) */}
    <script is:inline>
      (function () {
        try {
          // 仅在中文版根路径 / 执行(英文版 /en/ 不需要)
          var path = window.location.pathname;
          if (path !== '/') return;
          // 用户已设过偏好,尊重
          var saved = localStorage.getItem('momo-lang');
          if (saved) return;
          // 检测浏览器首选语言
          var navLang = (navigator.language || navigator.userLanguage || 'zh').toLowerCase();
          // 英文为主且不含中文 → 跳英文版
          if (navLang.indexOf('zh') === -1 && navLang.indexOf('en') === 0) {
            window.location.replace('/en/');
          }
        } catch (e) {}
      })();
    </script>

    <!-- 初始化主题（在 React hydrate 前应用，避免明暗闪烁） -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('momo-theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.setAttribute('data-theme', saved);
          }
        } catch (e) {}
      })();
    </script>

    <!-- 注册 Service Worker (PWA 离线 + 可安装到桌面) -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js', { scope: '/' })
            .catch(function (err) {
              console.warn('[PWA] Service Worker 注册失败:', err);
            });
        });
      }
    </script>
  </head>
  <body>
    <AppShell client:load initialLang={lang} />
    <main>
      <slot />
    </main>
    {/* 移动端 AdSense 信息流广告:< 1280px 显示,桌面端用两侧 fixed 广告避免重复 */}
    <aside class="mobile-in-feed-ad" aria-hidden="true">
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-format="fluid"
        data-ad-layout-key="-hi+e-a-53+a7"
        data-ad-client="ca-pub-1315335444091074"
        data-ad-slot="8459866523"></ins>
      <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </aside>

    <Footer />

    {/* 两侧 AdSense 广告位:桌面端(≥1280px)固定显示在主内容两侧空白处,
        移动端隐藏避免遮挡主内容(AdSense 政策要求) */}
    <aside class="side-ad side-ad-left" aria-hidden="true">
      <ins
        class="adsbygoogle"
        style="display:block;width:160px;height:600px"
        data-ad-client="ca-pub-1315335444091074"
        data-ad-slot="5253294852"></ins>
      <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </aside>
    <aside class="side-ad side-ad-right" aria-hidden="true">
      <ins
        class="adsbygoogle"
        style="display:block;width:160px;height:600px"
        data-ad-client="ca-pub-1315335444091074"
        data-ad-slot="5253294852"></ins>
      <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </aside>

    <style>
      /* 移动端信息流广告:占满主内容宽度,显示在 Footer 之前的内容流末尾 */
      .mobile-in-feed-ad {
        display: none;
        max-width: 56rem;
        margin: 1.5rem auto;
        padding: 0 1.5rem;
      }
      /* 仅在 < 1280px 时显示(桌面端用两侧 fixed 广告,避免重复投放) */
      @media (max-width: 1279px) {
        .mobile-in-feed-ad {
          display: block;
        }
      }

      /* 侧边广告位定位:固定在主内容(56rem≈896px)两侧,顶部留 88px 避开 Header */
      .side-ad {
        position: fixed;
        top: 88px;
        width: 160px;
        height: 600px;
        z-index: 5;
        display: none;
      }
      .side-ad-left {
        left: calc(50% - 624px); /* 448(主内容左半) + 16(间距) + 160(广告宽) = 624 */
      }
      .side-ad-right {
        right: calc(50% - 624px);
      }
      /* 仅在视口宽度 ≥1280px 时显示(主内容 896 + 两侧广告 320 + 间距 32 ≈ 1248) */
      @media (min-width: 1280px) {
        .side-ad {
          display: block;
        }
      }
    </style>

    <!-- Web Vitals 上报(生产环境自动启用,本地开发不上报) -->
    <script src="/vitals.js" defer></script>
  </body>
</html>
