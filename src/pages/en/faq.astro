---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_FAQ } from '../../data/toolTutorials';

const title = 'FAQ - Momo Toolbox';
const description = 'Momo Toolbox FAQ: Is it free? Is data safe? Does it work offline? Browser compatibility? How to switch languages? Is tool data uploaded? Find detailed answers and usage guide here.';
const canonical = 'https://www.web-tools.top/en/faq';

// JSON-LD FAQ structured data (good for SEO)
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: SITE_FAQ.en.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<BaseLayout lang="en" title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <article class="legal-page">
    {/* Static SEO h1: bilingual switching, ensures exactly one h1 on the page */}
    <h1 data-zh="常见问题" data-en="FAQ">FAQ</h1>
    <p class="updated"><span data-zh="在这里找到 Momo工具箱的常见问题解答" data-en="Find answers to common questions about Momo Toolbox">Find answers to common questions about Momo Toolbox</span></p>

    <div data-lang="en">
      <p>If you can't find an answer here, please <a href="mailto:1902243211@qq.com">email us</a>.</p>

      {SITE_FAQ.en.map((item, i) => (
        <div style="margin-bottom: 1.75rem;">
          <h2 style="font-size: 1.05rem; font-weight: 600; margin-top: 1.5rem; margin-bottom: 0.5rem; color: var(--accent);">
            {i + 1}. {item.q}
          </h2>
          <p>{item.a}</p>
        </div>
      ))}
    </div>

    <div style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border);">
      <a href="/en/" style="color: var(--accent); text-decoration: underline;" data-zh="← 返回首页" data-en="← Back to Home">← Back to Home</a>
    </div>
  </article>
</BaseLayout>
