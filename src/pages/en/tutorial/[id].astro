---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { TOOLS, getToolById } from '../../../constants';
import { TOOL_TUTORIALS } from '../../../data/toolTutorials';

// Generate a static page for each tool that has a tutorial
export function getStaticPaths() {
  return TOOLS.filter(tool => TOOL_TUTORIALS[tool.id]).map(tool => ({
    params: { id: tool.id },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const tutorial = TOOL_TUTORIALS[tool.id];
if (!tutorial) {
  return Astro.redirect('/404');
}

const title = tutorial.seoTitle.en;
const description = tutorial.seoDescription.en;
const canonical = new URL(`/en/tutorial/${tool.id}/`, Astro.site).toString();

// JSON-LD structured data (HowTo schema)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: `${tool.name.en} Tutorial`,
  description: tutorial.usage.en,
  inLanguage: 'en',
  totalTime: 'PT5M',
  supply: [{
    '@type': 'HowToSupply',
    name: 'A device with a modern browser',
  }],
  tool: [{
    '@type': 'HowToTool',
    name: tool.name.en,
  }],
  step: tutorial.examples.en.map((example, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: `Example ${i + 1}`,
    text: example,
  })),
};

// Breadcrumb structured data: lets Google show Home > Tool > Tutorial in search results
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.web-tools.top/en/' },
    { '@type': 'ListItem', position: 2, name: tool.name.en, item: `https://www.web-tools.top/en/tool/${tool.id}/` },
    { '@type': 'ListItem', position: 3, name: `${tool.name.en} Tutorial`, item: canonical },
  ],
};
---

<BaseLayout
  lang="en"
  title={title}
  description={description}
  canonical={canonical}
  articleMeta={{
    author: 'Momo Toolbox',
    section: 'Tutorial',
    tags: tool.tags,
    publishedTime: '2026-06-28T00:00:00+08:00',
    modifiedTime: '2026-06-28T00:00:00+08:00',
  }}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

  <article class="legal-page" style="max-width: 48rem;">
    <!-- Breadcrumb navigation -->
    <nav class="flex items-center gap-2 text-xs mb-6" style="color: var(--text-muted);">
      <a href="/en/" style="color: var(--text-muted);" data-zh="首页" data-en="Home">Home</a>
      <span>/</span>
      <a href={`/en/tool/${tool.id}/`} style="color: var(--text-muted);" data-zh={tool.name.zh} data-en={tool.name.en}>{tool.name.en}</a>
      <span>/</span>
      <span style="color: var(--text);" data-zh="教程" data-en="Tutorial">Tutorial</span>
    </nav>

    {/* Static SEO h1: bilingual switching, ensures exactly one h1 on the page */}
    <h1 style="margin-bottom: 0.5rem;">
      <span data-zh={`${tool.name.zh} 使用教程`} data-en={`${tool.name.en} Tutorial`}>{tool.name.en} Tutorial</span>
    </h1>
    <p class="updated"><span data-zh="详细使用指南、最佳实践与常见问题解答" data-en="Detailed guide, best practices, and FAQ">Detailed guide, best practices, and FAQ</span></p>

    <!-- Use this tool now button -->
    <div style="margin: 2rem 0; padding: 1.5rem; background: var(--bg-2); border: 1px solid var(--border); border-radius: 1rem; text-align: center;">
      <a
        href={`/en/tool/${tool.id}/`}
        style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; background: var(--accent); color: #fff; border-radius: 0.75rem; font-weight: 600; text-decoration: none; box-shadow: 0 4px 12px rgba(var(--accent-rgb), 0.3);"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="5 3 19 12 5 21 5 3" />
        </svg>
        <span data-zh="立即使用此工具" data-en="Use this tool now">Use this tool now</span>
      </a>
    </div>

    <!-- Use cases (English only) -->
    <div data-lang="en">
      <h2>Use Cases</h2>
      <p>{tutorial.usage.en}</p>
    </div>

    <!-- Features (English only) -->
    <div data-lang="en">
      <h2>Features</h2>
      <ul>
        {tutorial.features.en.map(feature => <li>{feature}</li>)}
      </ul>
    </div>

    <!-- Examples (English only) -->
    <div data-lang="en">
      <h2>Examples</h2>
      {tutorial.examples.en.map((example, i) => (
        <p><strong>Example {i + 1}:</strong> {example}</p>
      ))}
    </div>

    <!-- Best practices (English only) -->
    <div data-lang="en">
      <h2>Best Practices</h2>
      <ul>
        {tutorial.bestPractices.en.map(tip => <li>{tip}</li>)}
      </ul>
    </div>

    <!-- FAQ (English only) -->
    <div data-lang="en">
      <h2>FAQ</h2>
      {tutorial.faq.en.map(item => (
        <div style="margin-bottom: 1.5rem;">
          <h3 style="font-size: 1rem; font-weight: 600; margin-bottom: 0.5rem; color: var(--accent);">{item.q}</h3>
          <p>{item.a}</p>
        </div>
      ))}
    </div>

    <!-- Bottom CTA -->
    <div style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <a href={`/en/tool/${tool.id}/`} style="color: var(--accent); text-decoration: underline;" data-zh="← 立即使用工具" data-en="← Use this tool">← Use this tool</a>
      <a href="/en/" style="color: var(--text-muted); text-decoration: underline;" data-zh="返回首页" data-en="Back to Home">Back to Home</a>
    </div>
  </article>
</BaseLayout>
